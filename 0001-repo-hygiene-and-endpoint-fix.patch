-  // -- Assignment catalog (GitHub tree) --------------------------------
-  // Programming-only year folders, e.g.
-  // programming/baccalaureate/grade-2-secondary/loops-iteration/assignment.html
-  // Any assignment.html NOT under a grade-N-secondary folder (English,
-  // Math, and any Programming lesson outside the year split) applies to
-  // both years. This is read straight from the live repo tree, so it's
-  // always current with zero manifest to maintain.
-  var GITHUB_REPO = "EzzNasr/teaching.ezznasr.dev";
-  var YEAR_FOLDER_RE = /^grade-(\d+)-secondary$/i;
-  // NOTE: assumes grade-1-secondary = "Senior 1", grade-2-secondary =
-  // "Senior 2" — flip this map if that's backwards.
-  var FOLDER_TO_YEAR = { "grade-1-secondary": "Senior 1", "grade-2-secondary": "Senior 2" };
-
-  function fetchAssignmentCatalog() {
-    var branches = ["main", "master"];
-    function tryBranch(i) {
-      if (i >= branches.length) return Promise.resolve([]);
-      var url = "https://api.github.com/repos/" + GITHUB_REPO + "/git/trees/" + branches[i] + "?recursive=1";
-      return fetch(url).then(function (resp) {
-        if (!resp.ok) return tryBranch(i + 1);
-        return resp.json().then(function (data) {
-          if (!data || !Array.isArray(data.tree)) return tryBranch(i + 1);
-          return parseCatalog(data.tree);
-        });
-      }).catch(function () { return tryBranch(i + 1); });
-    }
-    return tryBranch(0);
-  }
-
-  function parseCatalog(tree) {
-    var catalog = [];
-    tree.forEach(function (entry) {
-      if (entry.type !== "blob" || !/\/assignment\.html$/.test(entry.path)) return;
-      var segments = entry.path.split("/");
-      if (segments.length < 3) return; // need at least subject/lesson/assignment.html
-      var subject = segments[0];
-      var lesson = segments[segments.length - 2];
-      var year = null;
-      for (var i = 1; i < segments.length - 2; i++) {
-        var m = segments[i].match(YEAR_FOLDER_RE);
-        if (m) { year = FOLDER_TO_YEAR[segments[i].toLowerCase()] || ("Grade " + m[1]); break; }
-      }
-      catalog.push({ subject: subject, lesson: lesson, year: year });
-    });
-    return catalog;
-  }
