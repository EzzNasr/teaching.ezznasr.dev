-<script>
-(function () {
-  "use strict";
-
-  // -- Small helpers (same conventions as student.html) -------------------
-
-  function el(tag, attrs, children) {
-    var node = document.createElement(tag);
-    attrs = attrs || {};
-    Object.keys(attrs).forEach(function (k) {
-      if (k === "class") node.className = attrs[k];
-      else if (k === "html") node.innerHTML = attrs[k];
-      else node.setAttribute(k, attrs[k]);
-    });
-    (children || []).forEach(function (c) {
-      if (c) node.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
-    });
-    return node;
-  }
-
-  function fmtPct(score, total) {
-    if (!total) return "\u2014";
-    return Math.round((score / total) * 100) + "%";
-  }
-
-  function scoreClass(score, total) {
-    if (!total) return "is-mid";
-    var pct = score / total;
-    if (pct >= 0.8) return "is-good";
-    if (pct >= 0.5) return "is-mid";
-    return "is-low";
-  }
-
-  function isTruthyFlag(v) {
-    return v === true || String(v).toUpperCase() === "TRUE";
-  }
-
-  function normalizePhone(s) {
-    return String(s || "").replace(/[^0-9]/g, "");
-  }
-
-  function newestFirst(rows) {
-    return (rows || []).slice().reverse();
-  }
-
-  function parseQuestions(row) {
-    try {
-      var parsed = JSON.parse(row.questions_json || "[]");
-      return Array.isArray(parsed) ? parsed : [];
-    } catch (e) {
-      return [];
-    }
-  }
-
-  function maskPhone(phone) {
-    var digits = normalizePhone(phone);
-    if (digits.length <= 4) return digits;
-    return "\u2022\u2022\u2022\u2022 " + digits.slice(-4);
-  }
-
-  // -- Aggregation (all client-side, over whatever's currently filtered) --
-
-  function aggregateChapters(quizRows) {
-    var byChapter = {};
-    quizRows.forEach(function (row) {
-      parseQuestions(row).forEach(function (q) {
-        var chapter = q.chapter || "Unlabeled";
-        if (!byChapter[chapter]) byChapter[chapter] = { correct: 0, total: 0 };
-        byChapter[chapter].total += 1;
-        if (isTruthyFlag(q.is_correct)) byChapter[chapter].correct += 1;
-      });
-    });
-    return Object.keys(byChapter)
-      .map(function (chapter) {
-        var c = byChapter[chapter];
-        return { chapter: chapter, correct: c.correct, total: c.total, pct: c.total ? c.correct / c.total : 0 };
-      })
-      .sort(function (a, b) { return a.pct - b.pct; });
-  }
-
-  // Keyed on lesson + exact question text (per the master plan's decision
-  // #3) so identical wording in two different lessons is never merged.
-  function aggregateMostMissed(quizRows) {
-    var byKey = {};
