-                .replace("{{DWG_NO}}", "01")
-                .replace("{{ABOUT_BLOCK}}", ""))
-        subj = subj.replace(start_marker + "\n" + end_marker, start_marker + "\n" + card + end_marker)
-        with open(path, "w", encoding="utf-8") as f:
-            f.write(subj)
