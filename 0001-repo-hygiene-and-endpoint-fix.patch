-                                .replace("{{ASSIGN_PROMPT}}", self.assign_prompt_var.get().strip() or
-                                         "Paste your completed assignment below."))
-            with open(os.path.join(lesson_dir, "assignment.html"), "w", encoding="utf-8") as f:
