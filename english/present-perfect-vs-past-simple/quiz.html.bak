    </nav>
  </div>
</header>

<main>
  <div class="wrap page-head">
    <h1>Present Perfect Vs Past Simple — quiz</h1>
    <p class="lede">20 questions. Instant feedback.</p>
  </div>

  <div class="wrap">
    <div id="quiz-root" aria-live="polite"></div>
  </div>
</main>

<footer><div class="wrap"><p class="footer-note">teaching.ezznasr.dev/english/present-perfect-vs-past-simple/quiz</p></div></footer>

<script type="application/json" id="quiz-data">
{
  "title": "Present Perfect Vs Past Simple",
  "subject": "english",
  "lesson": "present-perfect-vs-past-simple",
  "questions": [
    {
      "q": "Which sentence is in the Present Perfect?",
      "options": [
        "I visited Egypt last year.",
        "She traveled to Cairo yesterday.",
        "I have visited Egypt before.",
        "He ate sushi on Friday."
      ],
      "correct": 2,
      "explain": ""
    },
    {
      "q": "What is the structure of the Present Perfect?",
      "options": [
        "Subject + did + V2",
        "Subject + have/has + V3",
        "Subject + was/were + V-ing",
        "Subject + V2 + object"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which helper verb is used with \"He\"?",
      "options": [
        "have",
        "did",
        "has",
        "were"
      ],
      "correct": 2,
      "explain": ""
    },
    {
      "q": "Which helper verb is used with \"They\"?",
      "options": [
        "has",
        "have",
        "did",
        "was"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "When do we use the Present Perfect for life experiences?",
      "options": [
        "When we give an exact time",
        "When the exact time is not important",
        "Only for actions happening now",
        "Only for actions happening yesterday"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which sentence uses the Past Simple?",
      "options": [
        "I have eaten sushi.",
        "She has visited the pyramids.",
        "We have seen that movie.",
        "I ate sushi yesterday."
      ],
      "correct": 3,
      "explain": ""
    },
    {
      "q": "Which sentence correctly uses the Present Perfect?",
      "options": [
        "She has traveled to Japan.",
        "She has travel to Japan.",
        "She have traveled to Japan.",
        "She traveled has to Japan."
      ],
      "correct": 0,
      "explain": ""
    },
    {
      "q": "Which sentence correctly uses the Past Simple?",
      "options": [
        "I have visited Cairo yesterday.",
        "I visited Cairo yesterday.",
        "I have visit Cairo yesterday.",
        "I has visited Cairo yesterday."
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which sentence uses the Present Perfect?",
      "options": [
        "Sara traveled to Cairo last summer.",
        "Sara visited the Pyramids last summer.",
        "Sara has become interested in ancient history.",
        "Sara took hundreds of photos."
      ],
      "correct": 2,
      "explain": ""
    },
    {
      "q": "Which sentence uses the Past Simple?",
      "options": [
        "She has read five books about Egypt.",
        "She has watched three documentaries.",
        "She has fallen in love with the culture.",
        "She visited the Pyramids of Giza."
      ],
      "correct": 3,
      "explain": ""
    },
    {
      "q": "Complete the sentence: \"I _______ never _______ a lion in the wild.\"",
      "options": [
        "have / seen",
        "has / saw",
        "did / seen",
        "have / saw"
      ],
      "correct": 0,
      "explain": ""
    },
    {
      "q": "Complete the sentence: \"He _______ just _______ lunch.\"",
      "options": [
        "have / eat",
        "has / eaten",
        "has / ate",
        "have / eaten"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which sentence is correct?",
      "options": [
        "They has finished their homework.",
        "They have finished their homework.",
        "They have finish their homework.",
        "They finished have their homework."
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which sentence gives a specific time in the past?",
      "options": [
        "I have eaten sushi.",
        "She has visited Egypt.",
        "We have seen that movie.",
        "We saw that movie on Friday."
      ],
      "correct": 3,
      "explain": ""
    },
    {
      "q": "Which sentence does NOT give a specific time?",
      "options": [
        "I ate sushi yesterday.",
        "She visited the pyramids last year.",
        "We saw that movie on Friday.",
        "I have eaten sushi."
      ],
      "correct": 3,
      "explain": ""
    },
    {
      "q": "What does the Present Perfect connect?",
      "options": [
        "Two future events",
        "The past to the present moment",
        "Only two past events",
        "The present to the future"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Which form is the past participle (V3) in \"She has spoken several languages\"?",
      "options": [
        "has",
        "spoken",
        "several",
        "languages"
      ],
      "correct": 1,
      "explain": ""
    },
    {
      "q": "Choose the correct sentence.",
      "options": [
        "We have been to the pyramids before.",
        "We has been to the pyramids before.",
        "We have went to the pyramids before.",
        "We been to the pyramids before."
      ],
      "correct": 0,
      "explain": ""
    },
    {
      "q": "Which sentence is in the Past Simple?",
      "options": [
        "Einstein has changed the way we understand physics.",
        "Cleopatra has spoken several languages.",
        "Sara took hundreds of photos.",
        "Leonardo has inspired artists for centuries."
      ],
      "correct": 2,
      "explain": ""
    },
    {
      "q": "Which sentence is in the Present Perfect?",
      "options": [
        "Sara traveled to Cairo.",
        "Sara visited the Pyramids.",
        "Sara took hundreds of photos.",
        "Sara has watched three documentaries."
      ],
      "correct": 3,
      "explain": ""
    }
  ]
}
</script>
<script src="/assets/auth.js"></script>
